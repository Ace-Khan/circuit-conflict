# Results — track summary CSV/JSON metrics, not regenerable intermediate arrays.
# (NOTE: the pipeline writes .npy, not .pt/.pkl — the old rules never matched anything.)
data/results/**/*.npy
data/results/**/*.pt
data/results/**/*.pkl

# Figures — track final PNG/PDF, not raw plotly JSON
figures/*.json

# macOS
.DS_Store

# VS Code
.vscode/settings.json
*.code-workspace
